{
  "appId": "com.lpits.lpprocess",
  "copyright": "Copyright 2026 LPITS",
  "asar": true,
  "files": [
    "**/*",
    "!**/WEB-INF{,/**}",
    "!drawio/src/main/webapp/stencils/**/*.xml",
    "!drawio/src/main/webapp/shapes{,/**}",
    "!drawio/src/main/webapp/js/diagramly{,/**}",
    "drawio/src/main/webapp/js/diagramly/{ElectronApp,DesktopLibrary}.js",
    "!drawio/src/main/webapp/js/grapheditor{,/**}",
    "!drawio/src/main/webapp/mxgraph/src{,/**}",
    "!drawio/src/main/webapp/mxgraph/mxClient.js",
    "!node_modules/@cantoo/pdf-lib/{cjs,dist,src,ts3.4}{,/**}",
    "!**/*.map"
  ],
  "directories": {
    "output": "./dist/"
  },
  "npmRebuild": false,
  "publish": {
    "provider": "github"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-${version}-windows-installer.${ext}",
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": false,
    "createDesktopShortcut": false
  },
  "msi": {
    "artifactName": "${productName}-${version}.${ext}",
    "runAfterFinish": false,
    "createDesktopShortcut": false
  },
  "afterPack": "build/fuses.mjs",
  "msiProjectCreated": "build/msi-project-created.mjs",
  "fileAssociations": [
    {
      "ext": "drawio",
      "name": "LPprocess Diagram",
      "description": "LPprocess Diagram",
      "mimeType": "application/vnd.lpits.lpprocess",
      "role": "Editor"
    },
    {
      "ext": "vsdx",
      "name": "VSDX Document",
      "description": "VSDX Document",
      "mimeType": "application/vnd.visio",
      "role": "Editor"
    },
    {
      "ext": [
        "mmd",
        "mermaid"
      ],
      "name": "Mermaid Diagram",
      "description": "Mermaid Diagram",
      "mimeType": "text/vnd.mermaid",
      "role": "Editor"
    }
  ]
}